# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# DEVELOPMENT image for the BROWSER version: runs the Vite dev server with HMR.
#
# The project source is bind-mounted at runtime (see docker-compose.dev.yml),
# so this image only carries the toolchain + installed dependencies. This is
# separate from the production `Dockerfile` (nginx) and does not affect it.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim
WORKDIR /app

# Install dependencies from the lockfile (this layer is cached until it changes).
COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 5173

# --host makes Vite listen on 0.0.0.0 so the server is reachable from the host.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
