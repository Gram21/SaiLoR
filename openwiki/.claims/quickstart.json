    {
      "id": "claim_73038aa7de1248059ddba1afcb29f3d4",
      "statement": "SaiLoR is a tool for conducting Systematic Literature Reviews (SLRs); a project is a project.json file (annotation schema + paper metadata) plus a sibling annotations/<paperId>/ folder (per-reviewer and consolidated annotation data), and the app renders each paper's PDF beside a schema-generated annotation form, writing annotations back to that split layout.",
      "evidence": [
        {
          "resource": "repo://README.md#L7-L13",
          "version": "repo-lines-v1:sha256:5760849b4d402694c7a056dcfc0183a5977804dd7f3c4069019d3548c9326817:"
        },
        {
          "resource": "repo://src/model/project.ts#L780-L876",
