  "claims": [
    {
      "id": "claim_eaef87a5f139424fa5f75b41af39d806",
      "statement": "The renderer reaches the Rust shell only through the SlrBridge interface (src/platform/bridge.ts) implemented by tauriBridge in src/platform/tauri.ts, whose command() mapping turns Electron-style channel names into snake_case Tauri command names (':' → '_', each capital → '_' + lowercase, e.g. project:open → project_open, pdf:embedMarks → pdf_embed_marks); call() packs positional args into named fields, send() is fire-and-forget with errors swallowed, and subscribe()/replace() wrap listen() for shell-emitted events, with replace() unsubscribing the previous listener first.",
      "evidence": [
        {
          "resource": "repo://src/platform/tauri.ts#L116-L120",
          "version": "repo-lines-v1:sha256:b9a856129aacb48a26ee8f1e62a88671051017e91464ba9a4cc44c72097b734a:"
