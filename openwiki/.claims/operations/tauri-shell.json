    {
      "id": "claim_9c05a5659c5349c1be9c2da66650a9c7",
      "statement": "LLM API keys never reach the renderer: llm_save_config stores a non-empty key in the OS keychain (keyring crate, service SaiLoR, account llm:<id>) and writes only a keyring marker into llm-config.json (raw JSON entries, mode 0600 on Unix, written through a temporary file, an unreadable file refused); llm_configs and save/delete return public_configs exposing only hasKey; build_call_headers substitutes the {{apiKey}} sentinel at call time; llm_call pins the URL to the config's scheme and origin, refuses redirects (NO_REDIRECT), refuses the key over http to non-local hosts, routes managed local models to the shell-run llama.cpp server over /v1/* and /health through the proxy-free LOOPBACK client, caps answers at 32 MB and times out after 10 minutes.",
      "evidence": [
        {
          "resource": "repo://src-tauri/src/llm.rs",
          "version": "repo-file-v1:sha256:eda19de2fd0ff99b2da2f06b1db4a69241034a04dced506314bcddcc7e22824f"
        }
      ]
    },
