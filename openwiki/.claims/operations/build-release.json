    {
      "id": "claim_f59f9fcd75714303a5c74d86222d1c09",
      "statement": "`release.yml` triggers on a `v*` tag push, `workflow_dispatch`, and release publication; its `release` job (skipped on a publish event) preflights that the tag matches `v<package.json version>`, that `plugins.updater.pubkey` is set (not the `REPLACE_` placeholder) and that `TAURI_SIGNING_PRIVATE_KEY` exists, then finds or creates a DRAFT release whose notes state macOS 15+ support, manual updates for deb/rpm, and that 1.x users must install this release once by hand (no auto-update across the Electron-to-2.0 migration).",
      "evidence": [
        {
          "resource": "repo://.github/workflows/release.yml#L1-L72",
          "version": "repo-lines-v1:sha256:1dadad95c2078baa35a038bd60e032dfa7a74a0fec910d4b9ba904ae707baa9b:"
