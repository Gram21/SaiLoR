  "claims": [
    {
      "id": "claim_77c235236a4f499f9da38bd07202a799",
      "statement": "SaiLoR is a single React codebase run inside the Tauri shell; the web/SPA runtime is discontinued. App.tsx's isTauri() gate checks for '__TAURI_INTERNALS__' in window and, when absent, renders a 'use the desktop app' notice that blocks every project-opening UI before any of it can be reached — the gate renders only after all seven top-level hooks (keybindings, dirty guard, close guard, window title, consolidation alignment, autosave, upstream polling) have run. The online demo build lifts the gate via DEMO_MODE (`!isTauri() && !DEMO_MODE`).",
      "evidence": [
        {
          "resource": "repo://src/App.tsx#L205-L210",
          "version": "repo-lines-v1:sha256:380551a1a2ed67473ccaea79038665048b9751515df0fc35a2e3f042ab167c5d:"
        },
        {
          "resource": "repo://src/platform/adapter.ts",
          "version": "repo-file-v1:sha256:5377036bf0f2870106b0bbda752b23cf8699f814147bef97f80ea43811ae1e8a"
        }
      ]
    },
