    {
      "id": "claim_77c235236a4f499f9da38bd07202a799",
      "statement": "SaiLoR is a single React codebase run as an Electron desktop app; the web/SPA runtime is discontinued. App.tsx's isElectron() gate checks for the preload-bridged window.slr object and, when absent, renders a 'use the desktop app' notice that blocks every project-opening UI before any of it can be reached.",
      "evidence": [
        {
          "resource": "repo://src/App.tsx#L161-L191",
          "version": "repo-lines-v1:sha256:04671694b84e047582848b41fd450daaec50d1874fd72121f0c296930afe3830:"
        },
        {
          "resource": "repo://src/platform/adapter.ts#L319-L321",
          "version": "repo-lines-v1:sha256:6870b76bc493e61fd244995396eb37495ad7cc642efdeb02551dce2a274f2e86:"
        }
      ]
    },
    {
      "id": "claim_3f404acf3a284594b2d0c12df0a649aa",
      "statement": "The renderer (React 19 + Zustand + immer) talks to the Electron main process only through the window.slr bridge exposed by electron/preload.ts via contextBridge; the main process is the only thing that touches the filesystem, spawns git, or calls LLM providers.",
      "evidence": [
