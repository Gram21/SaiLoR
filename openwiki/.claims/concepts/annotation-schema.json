    {
      "id": "claim_fedb3978cb9242f0b48f81a013e21d15",
      "statement": "The annotation tree machinery in annotations.ts enforces cardinality: initTree materializes max(min,1) instances per node, normalizeTree reconciles a loaded tree (drops unknown keys, pads up to min and clamps to max, and adopts a bare primitive/single-object written where a list was expected rather than discarding a real answer), pruneTree drops only trailing empty instances keeping required ones, and canAdd/canRemove gate the form controls against max/min.",
      "evidence": [
        {
          "resource": "repo://src/model/annotations.ts#L51-L146",
          "version": "repo-lines-v1:sha256:c505f0993d635e1e387b5f341c5762d439316b0e4fe6c81a5b3d0e36c6438944:"
        }
