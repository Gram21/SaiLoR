    {
      "id": "claim_097c37eb91e14976baff01f256518be3",
      "statement": "classifyPair evaluates a candidate pair in fixed priority order each strictly stronger than the next: identical normalized DOI is certain (year veto never applies), exact normalized title is certain unless downgraded by a large year gap / DOI conflict / no shared authors, fuzzy whole-title above 0.90 is probable, and base-title-plus-authors (title before first colon, fuzzy + author-surname Dice >= 0.50) is probable.",
      "evidence": [
