        }
      ]
    },
    {
      "id": "claim_bc7524bd913442bf997a3de55c7bc7e4",
      "statement": "Cardinality uses min (default 1) and max (default 1, null = unbounded); isRepeatable is max===null || max>1; cardinality applies to groups too (a repeatable group produces parallel copies of its whole sub-tree), and the annotation value tree mirrors this as an object keyed by node name holding an array of instances bounded by min/max.",
      "evidence": [
        {
          "resource": "repo://src/model/annotations.ts#L10-L24",
          "version": "repo-lines-v1:sha256:bba03c091cbe17a95a7b656fdecac8a791fc336a95aa6542498276e6ada453fd:"
