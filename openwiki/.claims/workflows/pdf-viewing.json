        }
      ]
    },
    {
      "id": "claim_eed5f712772c4159921eef73d08c7299",
      "statement": "orderMarksForLinking pins up to three of this session's own marks (tracked by sessionCreatedMarkIds, not every mark's createdAt, so reopening a paper with old highlights doesn't pin random ones) most-recently-made first, then the rest in sortMarksForCycling order, with each mark appearing exactly once.",
