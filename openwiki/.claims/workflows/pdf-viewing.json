  "claims": [
    {
      "id": "claim_b410c03b2c5e4183ab4744569122404e",
      "statement": "PDF marks are SaiLoR's own overlay data stored as fractions of the page's rendered size, never written into the PDF binary; they live in the project's marks-*.json files and are burned into real PDF annotations only on explicit export. Keeping the PDF untouched lets it stay a plain relative-path reference shared and diffed by git, since writing real annotation objects into the file would make every reviewer's mark a binary edit to a shared file with no way to tell whose is whose.",
      "evidence": [
        {
          "resource": "repo://src/model/pdfMarks.ts#L1-L21",
          "version": "repo-lines-v1:sha256:1fbb18feee06cf62e74cc10f4ab2b2c9a9a94abc3be3a6e6586c00783501ee18:"
        }
      ]
    },
    {
      "id": "claim_7a615870445c415e992f15d3124a9f67",
      "statement": "A PdfMark stores rects as fractions (0..1, top-left origin) so they stay correct at any zoom without pdf.js viewport math; a text highlight has one rect per wrapped line, a sticky note has one rect whose x/y is the pinned point. kind distinguishes highlight from note, text captures the selected text once at creation, linkedFields holds denormalized field links, and groupId marks fragments of one cross-page highlight kept in sync.",
      "evidence": [
        {
          "resource": "repo://src/model/pdfMarks.ts#L22-L68",
          "version": "repo-lines-v1:sha256:f92a140f1363a974bfc0555f1b08c62af7953377f419f4799c9c635d4d1940b9:"
        }
      ]
    },
    {
      "id": "claim_b53e70bc56e54cb28b3f58fce0749ea8",
      "statement": "sortMarksForCycling orders marks by page, then column (left half before right half at a 0.5 split), then the first rect's y within that column — because plain y interleaves a two-column paper's columns and plain x can reorder same-column highlights by indentation jitter. dedupeMarkGroups collapses cross-page fragments sharing a groupId to one entry and is the single place every list/count-marks consumer routes through so they never disagree about what counts as one mark.",
      "evidence": [
        {
          "resource": "repo://src/model/pdfMarks.ts#L145-L198",
