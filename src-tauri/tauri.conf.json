{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaiLoR-spike",
  "version": "../package.json",
  "identifier": "io.github.gram21.sailor.spike",
  "build": {
    "beforeDevCommand": "npx vite --config vite.spike.config.ts",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "npx vite build --config vite.spike.config.ts",
    "frontendDist": "../dist-spike"
  },
  "app": {
    "windows": [
      {
        "title": "SaiLoR spike",
        "width": 900,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Gram21/SaiLoR/releases/latest/download/latest.json"],
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBLIC_KEY",
      "requireSignedVersion": true
    }
  }
}
