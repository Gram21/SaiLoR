{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaiLoR",
  "version": "../package.json",
  "identifier": "io.github.gram21.sailor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SaiLoR",
        "create": false,
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Gram21/SaiLoR/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyNDM3OEQ3MUNERTAzOTAKUldTUUE5NGMxM2hEOHE2S1lNMDBhZnY4L1VVdTE4cmUwbFFqakovcEtlZzNaR1dsZjZuc3dNOWEK",
      "requireSignedVersion": true
    }
  }
}
